{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "izzat-express",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "IZZAT_STORE"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
